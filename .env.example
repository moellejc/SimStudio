# Local defaults match docker-compose.yml. These are development placeholders, not production secrets.
POSTGRES_USER=radlab
POSTGRES_PASSWORD=radlab
POSTGRES_DB=radlab
DATABASE_URL=postgresql://radlab:radlab@localhost:5432/radlab
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=radlab-artifacts
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
JWT_SECRET=dev-only-change-me
COOKIE_SECURE=false
SIM_GRPC_ADDR=127.0.0.1:50051
SIM_MODE=mock
INSTALL_SOLVER=false
# Pinned in sim-server/Dockerfile: OpenCourant latest-20261011 / OpenCourant_linux64.zip
# sha256 6cb419677ca36d73acb96218cc0cf5e4f7d50494d9c7812ba27935e3c0f8ec94
OPENRADIOSS_PATH=
OPENRADIOSS_EXEC=
# Default for engine_linux64_gf. The study thread count overrides this per run.
OMP_NUM_THREADS=2
