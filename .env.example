# Local defaults match docker-compose.yml. These are development placeholders, not production secrets.
POSTGRES_USER=radlab
POSTGRES_PASSWORD=radlab
POSTGRES_DB=radlab
DATABASE_URL=postgresql://radlab:radlab@localhost:5432/radlab
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=radlab-artifacts
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
JWT_SECRET=dev-only-change-me
COOKIE_SECURE=false
SIM_GRPC_ADDR=127.0.0.1:50051
SIM_MODE=mock
INSTALL_SOLVER=false
OPENRADIOSS_PATH=
OMP_NUM_THREADS=2
